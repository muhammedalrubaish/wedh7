# انسخه إلى .env.local — هذا الملف وحده يُرفع للمستودع، و .env.local لا يُرفع.
#
# المفتاحان أدناه علنيان بحكم التصميم: يُشحنان داخل صفحة المتصفح ويستطيع أي زائر
# قراءتهما. أمان النظام لا يعتمد عليهما إطلاقاً، بل على سياسات RLS داخل Postgres.
#
# ⚠️ مشروع Supabase يُنشأ بحساب صاحب المحل لا المطوّر — انظر README قسم «الخصوصية».
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# لا تضع هنا أبداً: service_role key أو كلمة مرور قاعدة البيانات.
# أي منهما داخل الواجهة يتجاوز RLS بالكامل ويعطي صلاحية كاملة لكل من يفتح الصفحة.

# يُطفئ شريط «نسخة تجريبية» في وضع العرض (بلا قاعدة مربوطة).
# VITE_DEMO=0

# ---------------------------------------------------------------------------
# مفاتيح الخادم — تُضبط في Vercel ← Settings ← Environment Variables، لا هنا.
# لاحظ غياب بادئة VITE_ : هذا هو الفرق. أي متغير يبدأ بـ VITE_ يُحقن داخل ملفات
# الواجهة ويقرأه كل زائر؛ وما دونها يبقى على الخادم ولا يغادره.
# ---------------------------------------------------------------------------
# DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
